---
import '../styles/global.css'; import {business} from '../data/business.js';
const {title=business.seoTitle,description=business.seoDescription}=Astro.props; const canonical=new URL(Astro.url.pathname,Astro.site??'https://example.com');
---
<!doctype html><html lang={business.locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content={business.theme.navy}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={business.gallery[0].src}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL+'favicon.svg'}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/><title>{title}</title></head><body style={`--navy:${business.theme.navy};--navy-deep:${business.theme.navyDeep};--ink:${business.theme.ink};--muted:${business.theme.muted};--accent:${business.theme.accent};--accent-dark:${business.theme.accentDark};--paper:${business.theme.paper};--line:${business.theme.line};--pale:${business.theme.pale}`}><slot/></body></html>