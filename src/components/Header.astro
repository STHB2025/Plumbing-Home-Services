---
import ContactLink from './ContactLink.astro'; import {business} from '../data/business.js';
---
<div class="demo-banner">DEMO WEBSITE · Sample business details and testimonials · Replace before client launch</div><header class="site-header"><div class="wrap header-inner"><a class="brand" href="#top" aria-label={business.name+' home'}><span class="brand-mark" aria-hidden="true">⌁</span><span><strong>{business.name}</strong><small>{business.brandLabel}</small></span></a><nav id="primary-navigation" aria-label="Main navigation"><a href="#services">Services</a><a href="#about">About</a><a href="#areas">Service areas</a><a href="#contact">Contact</a></nav><div class="header-actions"><ContactLink business={business} label="Call the team" class="button button-primary header-call"/><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open navigation menu"><span></span><span></span></button></div></div></header>
<script>const b=document.querySelector('.menu-toggle'),n=document.querySelector('#primary-navigation');if(b instanceof HTMLButtonElement&&n instanceof HTMLElement){b.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!open));b.setAttribute('aria-label',open?'Open navigation menu':'Close navigation menu');n.classList.toggle('is-open',!open)});n.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{b.setAttribute('aria-expanded','false');n.classList.remove('is-open')}))}</script>