---
import ContactLink from './ContactLink.astro'; const {business}=Astro.props; const configured=/^https:\/\/formspree\.io\/f\/[\w-]+$/.test(business.formEndpoint); const services=business.services.filter(s=>s.enabled); const mailto=`mailto:${business.email}?subject=${encodeURIComponent('Plumbing quote request')}&body=${encodeURIComponent('Name:\nPhone:\nEmail:\nService required:\nProperty type:\nService location:\nProblem description:\nPreferred date:\nAdditional instructions:\n')}`;
---
{configured?<form id="quote-form" class="quote-form" action={business.formEndpoint} method="POST" data-form-id={business.formEndpoint.split('/').at(-1)}><input type="hidden" name="_subject" value={'New plumbing enquiry — '+business.name}/><div class="form-row"><label>Your name<input name="name" autocomplete="name" required placeholder="e.g. Alex Morgan"/></label><label>Contact number<input name="phone" type="tel" autocomplete="tel" required placeholder="e.g. 082 123 4567"/></label></div><div class="form-row"><label>Email address<input name="email" type="email" autocomplete="email" required placeholder="you@example.co.za"/></label><label>Service required<select name="service" required><option value="" selected disabled>Select a service</option>{services.map(s=><option value={s.name}>{s.name}</option>)}<option value="Other">Other / not sure</option></select></label></div><div class="form-row"><label>Property type<select name="property_type" required><option value="" selected disabled>Select type</option><option>Home</option><option>Flat or apartment</option><option>Business premises</option><option>Other</option></select></label><label>Service location<input name="location" autocomplete="street-address" required placeholder="Suburb or town"/></label></div><label>Describe the plumbing problem<textarea name="description" rows="4" required placeholder="What is happening? Include details that may help us understand the request."></textarea></label><div class="form-row"><label>Preferred service date<input name="preferred_date" type="date"/></label><label>Additional instructions <span class="optional">OPTIONAL</span><input name="instructions" placeholder="Anything else we should know?"/></label></div><p class="form-disclaimer">An enquiry is not a confirmed appointment or guaranteed quotation. The business will contact you to discuss next steps.</p><div class="form-feedback" data-fs-success role="status" aria-live="polite"></div><div class="form-feedback" data-fs-error role="alert" aria-live="assertive"></div><button class="button button-accent form-submit" type="submit">Send enquiry <span aria-hidden="true">↗</span></button></form>:<div class="form-fallback"><span class="fallback-icon" aria-hidden="true">↗</span><h3>Send an enquiry directly</h3><p>The online enquiry form is not active yet. Contact the business by email instead. This message will not be submitted to a form service.</p><div class="fallback-actions"><a class="button button-accent" href={mailto}>Email to enquire <span>↗</span></a><ContactLink business={business} kind="whatsapp" label="WhatsApp us" class="button button-outline"/></div><p class="form-disclaimer">An enquiry is not a confirmed appointment or guaranteed quotation.</p></div>}
{configured&&<script>import{initForm}from'@formspree/ajax/dist/index.mjs';const form=document.querySelector('#quote-form');if(form instanceof HTMLFormElement)initForm({formElement:'#quote-form',formId:form.dataset.formId,renderSuccess:({form})=>{const s=document.createElement('div');s.className='form-result';s.setAttribute('role','status');s.setAttribute('aria-live','polite');const h=document.createElement('h3');h.textContent='Thanks, your enquiry has been sent.';const p=document.createElement('p');p.textContent='The business will contact you about next steps. This is not a confirmed appointment or guaranteed quotation.';s.append(h,p);form.replaceWith(s)}})</script>}